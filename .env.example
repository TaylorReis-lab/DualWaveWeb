# DualWave — modelo de configuração, sem credenciais reais.
# Recomendado: node scripts/run-local.mjs dev
# Se .env não existir, o script cria a cópia com senha de banco e convite dev
# aleatórios. Se já existir, ele preserva a configuração e os segredos.
# Em execução local, .env.local tem prioridade sobre .env; variáveis do
# processo têm prioridade sobre ambos.

# PostgreSQL local (Docker). Em cópia manual, troque a senha nas DUAS linhas.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina-uma-senha-local
POSTGRES_DB=app_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:defina-uma-senha-local@127.0.0.1:5432/app_db

# Aplicação
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
APP_URL=http://127.0.0.1:3000

# Origem usada nos redirect URIs do OAuth (Spotify/Google).
# Os provedores comparam a URI caractere por caractere: "localhost" e "127.0.0.1"
# são DIFERENTES, e porta/barra final também contam. Por padrão o app usa o
# endereço acessado no navegador, então prefira não definir nada em dev local.
# Se aparecer "redirect_uri: Not matching configuration" / "redirect_uri_mismatch",
# cadastre as URIs exibidas em /dev ou fixe a origem aqui:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# OAUTH_REDIRECT_ORIGIN=https://seu-dominio.com

# Login de desenvolvedor: convite privado, não é a senha da sua conta.
# O script gera um valor aleatório ao criar .env ou ao preparar docker:up
# se ele ainda não tiver sido configurado. Consulte o valor no seu .env.
DEV_SIGNUP_CODE=

# Em dev permite /dev; no compose.app.yaml é sempre true.
DISABLE_DEV_CONSOLE=false

# Spotify (https://developer.spotify.com/dashboard)
# Cadastre a URI exata exibida em /dev; em loopback prefira 127.0.0.1.
# Ex.: http://127.0.0.1:3000/api/auth/spotify/callback
# Sem Client Secret, a integração usa PKCE.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google / YouTube (https://console.cloud.google.com)
# Habilite YouTube Data API v3 e cadastre a URI do callback.
# Ex.: http://127.0.0.1:3000/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Calculada por scripts/run-local.mjs docker:up, somente para a rede Docker.
# Defina manualmente apenas se usar Compose sem o script. A senha deve ser
# codificada para URL se contiver @, :, /, # ou outros caracteres especiais.
# DATABASE_URL_DOCKER=postgresql://postgres:SENHA@db:5432/app_db

# Opcional: muda o nome/volume do projeto Docker. Não compartilhe o mesmo
# nome entre um banco criado por "push" e outro gerenciado por migrations.
# COMPOSE_PROJECT_NAME=dualwave-dev
