# ==============================================================
# DualWave — variáveis de ambiente
# Copie para .env (ou .env.local) e preencha o que for usar.
# Todas são OPCIONAIS: sem elas o app funciona no modo sandbox.
# Você também pode gravar as credenciais direto no banco pelo
# Console Dev em http://localhost:3000/dev (não precisa reiniciar).
# ==============================================================

# Obrigatória — PostgreSQL local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --------------------------------------------------------------
# Spotify (https://developer.spotify.com/dashboard)
# Redirect URI: http://localhost:3000/api/auth/spotify/callback
# Sem CLIENT_SECRET o app usa PKCE (cliente público) automaticamente.
# --------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --------------------------------------------------------------
# Google / YouTube Music (https://console.cloud.google.com)
# Habilite a "YouTube Data API v3" no projeto.
# Redirect URI: http://localhost:3000/api/auth/youtube/callback
# --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API Key simples (não é OAuth) — usada para casar automaticamente
# cada faixa do Spotify com o vídeo oficial no YouTube.
YOUTUBE_API_KEY=

# --------------------------------------------------------------
# Opcionais
# --------------------------------------------------------------
# Força a origem pública usada nos redirect URIs (útil atrás de proxy/preview)
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# Define como "true" para DESABILITAR o Console Dev (/dev) em produção
DISABLE_DEV_CONSOLE=
